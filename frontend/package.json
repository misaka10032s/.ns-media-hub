{
  "name": "ns-media-hub-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "gate:g1": "node quality-gates/check-lint-diff.mjs",
    "gate:g3:test": "vitest run",
    "gate:g3:assertions": "node quality-gates/check-test-assertions.mjs",
    "gate:g3:determinism": "node quality-gates/check-test-determinism.mjs",
    "gate:g3": "npm run gate:g3:test && npm run gate:g3:assertions && npm run gate:g3:determinism",
    "gate:g4": "node quality-gates/check-import-cycles.mjs",
    "gate:g4:update-baseline": "node quality-gates/check-import-cycles.mjs --update-baseline",
    "gate:commit": "node quality-gates/check-lint-diff.mjs --staged && node quality-gates/check-test-determinism.mjs && node quality-gates/check-test-assertions.mjs --staged && node quality-gates/run-related-tests.mjs",
    "gate:l0": "npm run gate:g1 && npm run gate:g3 && npm run gate:g4",
    "gate:l1": "npm run gate:l0"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "madge": "^8.0.0",
    "sass": "^1.99.0",
    "typescript-eslint": "8.68.0",
    "vite": "^8.0.12",
    "vitest": "^3.2.7"
  }
}
